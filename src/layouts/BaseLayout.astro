---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'IHEIZ - Music Demo',
	description = 'IHEIZ – raw, minimalist 90s-style techno. Listen to the current demo selection.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#000000" />

		<!-- Vorschau beim Teilen (Mail, Messenger, Social). Für ein Vorschaubild
		     (og:image) wird eine absolute URL benötigt → erst mit fester Domain (`site` in astro.config). -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />

		<link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-v20-latin-200.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-v20-latin-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-v20-latin-900.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Ohne JavaScript den Preloader nicht dauerhaft über der Seite stehen lassen -->
		<noscript><style>#app-preloader { display: none !important; }</style></noscript>
		<slot name="head" />
	</head>
	<body class="bg-black text-white overflow-hidden select-none">
		<noscript>
			<p class="fixed inset-x-0 top-0 z-[200] bg-white p-3 text-center text-sm font-bold text-black">
				This page needs JavaScript to play the tracks.
			</p>
		</noscript>
		<slot />
	</body>
</html>
