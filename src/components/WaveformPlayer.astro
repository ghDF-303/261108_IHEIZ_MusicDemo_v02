---
import type { DownloadOptions } from '../types/track';

interface Props {
  audioUrl: string;
  title: string;
  accentColor: string;
  /** Vorberechnete Wellenform (0–1). Fehlt sie, wird sie als Notlösung im Browser berechnet. */
  peaks?: number[];
  download?: DownloadOptions | false;
}

const { audioUrl, title, accentColor, peaks, download = false } = Astro.props;
---

<div
  class="audio-player invisible absolute bottom-32 sm:bottom-32 md:bottom-28 w-full max-w-lg xl:max-w-2xl px-3 sm:px-6 flex flex-col items-center opacity-0 translate-y-6 pointer-events-none"
  data-audio-url={audioUrl}
  data-accent={accentColor}
  data-peaks={peaks ? JSON.stringify(peaks) : undefined}
>
  <audio src={audioUrl} preload="metadata" class="hidden"></audio>

  <div
    class="waveform-wrapper w-full relative cursor-ew-resize py-1 sm:py-2 touch-none rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--track-accent)]"
    role="slider"
    tabindex="0"
    aria-label={`Playback position: ${title}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="00:00"
  >
    <canvas class="waveform-canvas w-full h-12 sm:h-16 rounded" height="64"></canvas>
    <svg
      class="waveform-loading absolute inset-0 w-full h-full"
      viewBox="0 0 96 64"
      aria-hidden="true"
    >
      <rect class="waveform-loading-bar" x="22" y="25" width="4" height="14" rx="2" style="--bar-index: 0" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="30" y="20" width="4" height="24" rx="2" style="--bar-index: 1" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="38" y="14" width="4" height="36" rx="2" style="--bar-index: 2" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="46" y="8" width="4" height="48" rx="2" style="--bar-index: 3" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="54" y="14" width="4" height="36" rx="2" style="--bar-index: 4" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="62" y="20" width="4" height="24" rx="2" style="--bar-index: 5" vector-effect="non-scaling-stroke" />
      <rect class="waveform-loading-bar" x="70" y="25" width="4" height="14" rx="2" style="--bar-index: 6" vector-effect="non-scaling-stroke" />
    </svg>
  </div>

  <div class="player-bar w-full flex flex-row items-center justify-between sm:justify-center gap-2 sm:gap-6 mt-2 sm:mt-4">

    <div class="time-display font-mono text-[11px] sm:text-xs tracking-wider text-white/70 tabular-nums flex items-center gap-1 min-w-[70px] sm:min-w-[80px]">
      <span class="time-current text-white font-bold">00:00</span>
      <span class="text-white/40">/</span>
      <span class="time-total text-white/70">--:--</span>
    </div>

    <div class="player-controls flex items-center gap-1.5 sm:gap-3">
      <button type="button" class="btn-play p-2 sm:p-3 hover:scale-110 active:scale-95 transition-transform text-white cursor-pointer" aria-label={`Play ${title}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>

      <button type="button" class="btn-pause p-2 sm:p-3 hover:scale-110 active:scale-95 transition-transform text-white hidden cursor-pointer" aria-label={`Pause ${title}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-8 sm:h-8 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>

      <button type="button" class="btn-mute p-2 sm:p-2.5 hover:scale-110 active:scale-95 transition-transform text-white/80 hover:text-white cursor-pointer" aria-label="Mute" aria-pressed="false">
        <svg class="icon-unmuted w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
        </svg>
        <svg class="icon-muted w-5 h-5 sm:w-6 sm:h-6 fill-current hidden text-red-400" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
        </svg>
      </button>

      {download && (
        <div class="download-group flex items-center gap-1.5 sm:gap-2 border-l border-white/20 pl-2 sm:pl-4 ml-1">
          {download.mp3 && (
            <a
              href={download.mp3}
              download
              class="parallelogram-btn bg-white/10 hover:bg-white text-white hover:text-black font-black text-[10px] sm:text-xs uppercase tracking-wider px-3 py-1.5 sm:px-5 sm:py-2 transition-all flex items-center gap-1 cursor-pointer shadow-lg"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              MP3
            </a>
          )}
          {download.wav && (
            <a
              href={download.wav}
              download
              class="parallelogram-btn bg-white/10 hover:bg-white text-white hover:text-black font-black text-[10px] sm:text-xs uppercase tracking-wider px-3 py-1.5 sm:px-5 sm:py-2 transition-all flex items-center gap-1 cursor-pointer shadow-lg"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              WAV
            </a>
          )}
        </div>
      )}
    </div>

  </div>
</div>

<style>
  .waveform-canvas {
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .waveform-canvas.is-ready {
    opacity: 1;
  }

  .waveform-loading {
    color: var(--track-accent, #fff);
    transition: opacity 250ms ease;
  }

  .waveform-loading.is-hidden {
    opacity: 0;
  }

  .waveform-loading-bar {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: center;
    animation: waveform-pulse 900ms ease-in-out infinite;
    animation-delay: calc(var(--bar-index) * 80ms);
  }

  @keyframes waveform-pulse {
    0%, 100% { opacity: 0.45; transform: scaleY(0.35); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .waveform-loading-bar {
      animation: none;
      opacity: 0.7;
    }

    .waveform-canvas,
    .waveform-loading {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  // Muss zu BARS_COUNT in scripts/generate-peaks.mjs passen.
  const BARS_COUNT = 96;
  const SEEK_STEP = 5;   // Sekunden pro Pfeiltaste
  const SEEK_PAGE = 30;  // Sekunden pro Bild-auf/-ab
  // Neutrale Darstellung, falls eine Wellenform gar nicht ermittelt werden kann
  const FLAT_PEAKS = Array.from({ length: BARS_COUNT }, () => 0.35);

  const peaksCache = new Map<string, number[]>();

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || !isFinite(seconds) || seconds < 0) return '00:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  function parsePeaks(raw: string | undefined): number[] | null {
    if (!raw) return null;
    try {
      const parsed: unknown = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length > 0 && parsed.every((v) => typeof v === 'number')) {
        return parsed;
      }
    } catch {
      // ungültige Daten → Notlösung unten
    }
    return null;
  }

  /**
   * Notlösung für Tracks ohne vorberechnete Wellenform (`npm run peaks` vergessen).
   * Lädt und dekodiert die komplette Datei – auf Mobilgeräten teuer.
   */
  async function extractPeaks(url: string, bars: number): Promise<number[]> {
    const cached = peaksCache.get(url);
    if (cached) return cached;

    console.warn(`[WaveformPlayer] Keine vorberechnete Wellenform für ${url} – bitte "npm run peaks" ausführen.`);

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
      const arrayBuffer = await res.arrayBuffer();

      const OfflineCtxClass =
        window.OfflineAudioContext ||
        (window as unknown as { webkitOfflineAudioContext: typeof OfflineAudioContext }).webkitOfflineAudioContext;

      if (!OfflineCtxClass) throw new Error('OfflineAudioContext nicht unterstützt');

      const audioCtx = new OfflineCtxClass(1, 1, 44100);
      const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
      const channelData = audioBuffer.getChannelData(0);
      const blockSize = Math.floor(channelData.length / bars);
      const peaks: number[] = [];

      for (let i = 0; i < bars; i++) {
        const start = i * blockSize;
        let sum = 0;
        const sampleStep = 8;
        for (let j = 0; j < blockSize; j += sampleStep) {
          sum += Math.abs(channelData[start + j]);
        }
        peaks.push(sum / (blockSize / sampleStep));
      }

      const max = Math.max(...peaks, 0.01);
      const normalized = peaks.map(p => Math.max(0.12, p / max));
      peaksCache.set(url, normalized);
      return normalized;
    } catch {
      peaksCache.set(url, FLAT_PEAKS);
      return FLAT_PEAKS;
    }
  }

  function drawWaveform(canvas: HTMLCanvasElement, peaks: number[], progress: number, accent: string) {
    if (!peaks.length) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return;

    // Puffergröße nur bei Bedarf ändern (sonst wird bei jedem Frame neu alloziert)
    const pixelWidth = Math.floor(rect.width * dpr);
    const pixelHeight = Math.floor(rect.height * dpr);
    if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
    if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.clearRect(0, 0, rect.width, rect.height);
    const gap = 2;
    const totalGaps = (peaks.length - 1) * gap;
    const barWidth = Math.max(2, (rect.width - totalGaps) / peaks.length);
    const centerY = rect.height / 2;

    peaks.forEach((peak, index) => {
      const x = index * (barWidth + gap);
      const barHeight = Math.max(4, peak * (rect.height * 0.85));
      const y = centerY - barHeight / 2;
      const barProgress = index / peaks.length;

      ctx.fillStyle = barProgress <= progress ? accent : 'rgba(255, 255, 255, 0.3)';
      ctx.beginPath();
      if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(x, y, barWidth, barHeight, 2);
      } else {
        ctx.rect(x, y, barWidth, barHeight);
      }
      ctx.fill();
    });
  }

  const audioPlayers = document.querySelectorAll<HTMLElement>('.audio-player');

  audioPlayers.forEach(player => {
    const audio = player.querySelector<HTMLAudioElement>('audio');
    const canvas = player.querySelector<HTMLCanvasElement>('.waveform-canvas');
    const loadingIndicator = player.querySelector<SVGElement>('.waveform-loading');
    const wrapper = player.querySelector<HTMLElement>('.waveform-wrapper');
    const btnPlay = player.querySelector<HTMLButtonElement>('.btn-play');
    const btnPause = player.querySelector<HTMLButtonElement>('.btn-pause');
    const btnMute = player.querySelector<HTMLButtonElement>('.btn-mute');
    const iconUnmuted = player.querySelector<SVGElement>('.icon-unmuted');
    const iconMuted = player.querySelector<SVGElement>('.icon-muted');
    const timeCurrent = player.querySelector<HTMLElement>('.time-current');
    const timeTotal = player.querySelector<HTMLElement>('.time-total');

    const audioUrl = player.dataset.audioUrl ?? '';
    const accent = player.dataset.accent ?? '#ffffff';

    if (!audio || !canvas || !loadingIndicator || !wrapper || !btnPlay || !btnPause || !btnMute || !timeCurrent || !timeTotal) return;

    let currentPeaks: number[] = [];
    let isDragging = false;
    let peaksPromise: Promise<number[]> | undefined;

    const currentProgress = () => (audio.duration ? audio.currentTime / audio.duration : 0);

    /** Zeichnet die Wellenform und hält Zeitanzeige und Slider-Werte synchron. */
    const render = (progress: number, time: number) => {
      drawWaveform(canvas, currentPeaks, progress, accent);
      timeCurrent.textContent = formatTime(time);
      wrapper.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
      wrapper.setAttribute(
        'aria-valuetext',
        audio.duration ? `${formatTime(time)} of ${formatTime(audio.duration)}` : formatTime(time)
      );
    };

    const showPeaks = (peaks: number[]) => {
      currentPeaks = peaks;
      drawWaveform(canvas, currentPeaks, currentProgress(), accent);
      canvas.classList.add('is-ready');
      loadingIndicator.classList.add('is-hidden');
    };

    const precomputed = parsePeaks(player.dataset.peaks);
    if (precomputed) {
      // Sofort verfügbar – nichts muss heruntergeladen werden
      requestAnimationFrame(() => showPeaks(precomputed));
    }

    const loadPeaks = () => {
      if (precomputed) return;
      if (!peaksPromise) {
        peaksPromise = extractPeaks(audioUrl, BARS_COUNT).then(peaks => {
          showPeaks(peaks);
          return peaks;
        });
      }
    };

    player.addEventListener('track:activate', loadPeaks, { once: true });

    const setPlaying = (playing: boolean) => {
      btnPlay.classList.toggle('hidden', playing);
      btnPause.classList.toggle('hidden', !playing);
    };

    audio.addEventListener('loadedmetadata', () => {
      timeTotal.textContent = formatTime(audio.duration);
    });

    const resizeObserver = new ResizeObserver(() => {
      if (!currentPeaks.length) return;
      drawWaveform(canvas, currentPeaks, currentProgress(), accent);
    });
    resizeObserver.observe(wrapper);

    audio.addEventListener('timeupdate', () => {
      if (!isDragging && audio.duration) {
        render(currentProgress(), audio.currentTime);
      }
      if (timeTotal.textContent === '--:--' && audio.duration) {
        timeTotal.textContent = formatTime(audio.duration);
      }
    });

    audio.addEventListener('ended', () => {
      setPlaying(false);
      render(0, 0);
    });

    btnPlay.addEventListener('click', (e) => {
      e.stopPropagation();
      loadPeaks();
      window.dispatchEvent(new CustomEvent('track:play', { detail: { audio } }));
      audio.play().then(() => {
        setPlaying(true);
        btnPause.focus({ preventScroll: true });
      }).catch(() => {});
    });

    btnPause.addEventListener('click', (e) => {
      e.stopPropagation();
      audio.pause();
      setPlaying(false);
      btnPlay.focus({ preventScroll: true });
    });

    btnMute.addEventListener('click', (e) => {
      e.stopPropagation();
      audio.muted = !audio.muted;
      iconUnmuted?.classList.toggle('hidden', audio.muted);
      iconMuted?.classList.toggle('hidden', !audio.muted);
      btnMute.setAttribute('aria-pressed', String(audio.muted));
    });

    const seekTo = (progress: number) => {
      const clamped = Math.max(0, Math.min(1, progress));
      if (audio.duration) {
        const time = clamped * audio.duration;
        audio.currentTime = time;
        render(clamped, time);
      } else {
        drawWaveform(canvas, currentPeaks, clamped, accent);
      }
    };

    const handleScrub = (clientX: number) => {
      const rect = canvas.getBoundingClientRect();
      seekTo((clientX - rect.left) / rect.width);
    };

    wrapper.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      isDragging = true;
      wrapper.setPointerCapture(e.pointerId);
      handleScrub(e.clientX);
    });

    wrapper.addEventListener('pointermove', (e) => {
      if (isDragging) handleScrub(e.clientX);
    });

    const stopDragging = (e: PointerEvent) => {
      if (isDragging) {
        isDragging = false;
        try { wrapper.releasePointerCapture(e.pointerId); } catch {}
      }
    };
    wrapper.addEventListener('pointerup', stopDragging);
    wrapper.addEventListener('pointercancel', stopDragging);

    // Tastatursteuerung der Zeitleiste
    wrapper.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      const steps: Record<string, number> = {
        ArrowRight: SEEK_STEP,
        ArrowUp: SEEK_STEP,
        ArrowLeft: -SEEK_STEP,
        ArrowDown: -SEEK_STEP,
        PageUp: SEEK_PAGE,
        PageDown: -SEEK_PAGE,
      };
      let time: number;
      if (e.key in steps) time = audio.currentTime + steps[e.key];
      else if (e.key === 'Home') time = 0;
      else if (e.key === 'End') time = audio.duration;
      else return;

      e.preventDefault();
      e.stopPropagation();
      seekTo(time / audio.duration);
    });

    // Entkoppelte Steuerung: Andere Tracks stoppen
    window.addEventListener('track:play', (e: Event) => {
      const ce = e as CustomEvent<{ audio: HTMLAudioElement }>;
      if (ce.detail.audio !== audio && !audio.paused) {
        audio.pause();
        setPlaying(false);
      }
    });

    // Entkoppelte Steuerung: Fadeout bei Reset
    window.addEventListener('track:fade-active', () => {
      if (!audio.paused) {
        gsap.to(audio, {
          volume: 0,
          duration: 0.3,
          onComplete: () => {
            audio.pause();
            audio.volume = 1;
            audio.currentTime = 0;
            setPlaying(false);
            render(0, 0);
          }
        });
      }
    });
  });
</script>
