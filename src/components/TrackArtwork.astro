---
// src/components/TrackArtwork.astro
import HudLayer from './artworks/HudLayer.astro';
import HeroLayer from './artworks/HeroLayer.astro';

interface Props {
  trackId: number;
  accentColor: string;
  bgNumber?: string;
  isFeatured?: boolean;
}

const {
  trackId,
  accentColor,
  bgNumber,
  isFeatured = false
} = Astro.props;

const displayTag = bgNumber ?? trackId.toString().padStart(2, '0');
---

<div
  class="track-artwork-container pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden select-none z-[2]"
  style={`--artwork-color: ${accentColor};`}
>
  <!-- LAYER 1 (BG): Große Nummer (is-featured für den Lead-Track) -->
  <span
    class:list={[
      'bg-track-number pointer-events-none absolute font-black select-none leading-none opacity-15 text-[var(--artwork-color)]',
      isFeatured && 'is-featured'
    ]}
  >
    {displayTag}
  </span>

  <!-- LAYER 2 (MID): HUD Layer -->
  <div
    class="hud-layer pointer-events-none absolute inset-0 flex items-center justify-center will-change-transform text-[var(--artwork-color)]"
  >
    <HudLayer trackId={trackId} />
  </div>

  <!-- LAYER 3 (HERO): Emblem Layer -->
  <div
    class="hero-layer pointer-events-none relative z-10 flex items-center justify-center will-change-transform text-[var(--artwork-color)]"
    style={`filter: drop-shadow(0 0 25px ${accentColor}40);`}
  >
    <HeroLayer trackId={trackId} />
  </div>
</div>

<style>
  .bg-track-number {
    font-size: clamp(14rem, 24vw, 36rem);
  }

  /* LEAD TRACK: ca. 20% größer, auf gemeinsamer Mittelachse */
  .bg-track-number.is-featured {
    font-size: clamp(17rem, 29vw, 44rem);
  }
</style>
