---
// src/components/Preloader.astro
interface Props {
  demoTitle?: string;
}

const { demoTitle = 'A&R Promo Selection' } = Astro.props;
---

<div
  id="app-preloader"
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#050505] text-white select-none isolate"
  role="status"
  aria-busy="true"
  aria-label="Loading"
>
  <div class="preloader-content flex flex-col items-center text-center px-4 will-change-transform">
    <!-- GROSSER TITEL (die eigentliche h1 steht in index.astro) -->
    <p class="text-5xl sm:text-7xl md:text-8xl font-black uppercase tracking-tighter leading-none">
      IHEIZ
    </p>

    <!-- SUBTITLE (DEMO TITLE) -->
    <p class="text-sm sm:text-base md:text-lg font-bold uppercase tracking-widest text-white/80 mt-3 sm:mt-4">
      {demoTitle}
    </p>

    <!-- KLEINE KENNZEICHNUNG -->
    <span class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.3em] text-white/40 mt-1">
      Demo
    </span>

    <!-- ROTIERENDES HUD-SPINNER-SVG -->
    <div class="mt-8 sm:mt-10 relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14">
      <!-- Äußerer, segmentierter Tech-Ring -->
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-full animate-[spin_2s_linear_infinite] motion-reduce:animate-none"
        aria-hidden="true"
      >
        <circle
          cx="50"
          cy="50"
          r="44"
          stroke="currentColor"
          stroke-width="3"
          stroke-dasharray="70 40 20 40"
          class="text-white/30"
        />
        <circle
          cx="50"
          cy="50"
          r="44"
          stroke="currentColor"
          stroke-width="3"
          stroke-dasharray="30 180"
          stroke-linecap="square"
          class="text-white"
        />
      </svg>

      <!-- Innerer gegenläufiger Kern -->
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute inset-2 w-auto h-auto animate-[spin_1.2s_linear_infinite_reverse] motion-reduce:animate-none"
        aria-hidden="true"
      >
        <polygon
          points="50,20 76,65 24,65"
          stroke="currentColor"
          stroke-width="2"
          class="text-white/60"
        />
      </svg>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  // Mindestanzeige: verhindert unruhiges Aufflackern bei schnellem Cache
  const MIN_DISPLAY_MS = 600;
  // Sicherheitsnetz: Seite spätestens nach dieser Zeit freigeben, auch wenn ein Bild hängt
  const MAX_WAIT_MS = 5000;

  const preloader = document.querySelector<HTMLElement>('#app-preloader');
  const content = document.querySelector<HTMLElement>('.preloader-content');

  const delay = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

  // 1. Schriften abwarten
  const fontsPromise = 'fonts' in document ? document.fonts.ready.then(() => undefined) : Promise.resolve();

  // 2. Initial im DOM vorhandene Bilder abwarten
  const imagesPromise = Promise.all(
    Array.from(document.images).map((img) => {
      if (img.complete) return Promise.resolve();
      return new Promise<void>((resolve) => {
        img.addEventListener('load', () => resolve(), { once: true });
        img.addEventListener('error', () => resolve(), { once: true });
      });
    })
  );

  const ready = Promise.all([fontsPromise, imagesPromise, delay(MIN_DISPLAY_MS)]);

  // 3. Lifecycle ausführen
  Promise.race([ready, delay(MAX_WAIT_MS)]).then(() => {
    if (!preloader || !content) return;

    const tl = gsap.timeline({
      onComplete: () => {
        preloader.style.display = 'none';
        preloader.setAttribute('aria-busy', 'false');
      }
    });

    tl.to(content, {
      y: -20,
      opacity: 0,
      duration: 0.45,
      ease: 'power2.in'
    }).to(
      preloader,
      {
        opacity: 0,
        duration: 0.55,
        ease: 'power2.out'
      },
      '-=0.15'
    );
  });
</script>
