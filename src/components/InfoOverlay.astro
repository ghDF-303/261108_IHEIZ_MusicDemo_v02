---
// src/components/InfoOverlay.astro
---

<!-- BACKDROP / DIMMER: z-[70] (dunkelt Panels und Back-Button ab) -->
<div
  id="info-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs opacity-0 pointer-events-none z-[70] transition-opacity"
  aria-hidden="true"
></div>

<!-- TRIGGER-BUTTON: z-[90] (liegt garantiert ÜBER der 90px-Spitze des Overlays) -->
<button
  id="info-trigger-btn"
  type="button"
  class="fixed top-2 left-2 md:top-3 md:left-3 z-[90] p-1 text-white hover:text-white/80 drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)] transition-colors cursor-pointer flex items-center justify-center select-none"
  aria-label="Artist information"
  aria-expanded="false"
  aria-controls="info-overlay"
>
  <span
    id="info-icon-wrapper"
    class="inline-flex items-center justify-center w-8 h-8 md:w-9 md:h-9 will-change-transform"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full fill-current pointer-events-none"
      viewBox="0 0 24 24"
      width="36"
      height="36"
      aria-hidden="true"
    >
      <path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z"/>
    </svg>
  </span>
</button>

<!-- OVERLAY DRAWER: z-[75] (über Back-Button und Backdrop, unter Trigger-Button) -->
<aside
  id="info-overlay"
  class="fixed top-0 left-0 h-full z-[75] bg-[#27272a]/80 border-r border-white/10 text-white backdrop-blur-xl shadow-2xl flex flex-col justify-between overflow-hidden"
  aria-label="Artist info & contact"
>
  <!-- HAUPTCONTAINER: Auf mobilem Viewport auf 100dvh begrenzt mit Safe-Bottom-Padding.
       `inert` solange geschlossen: Links sind dann nicht per Tab erreichbar. -->
  <div inert class="info-content-box w-full md:w-[50vw] h-[100dvh] md:h-full overflow-hidden px-6 pt-14 pb-[calc(1.75rem+env(safe-area-inset-bottom,0px))] md:px-12 md:pt-20 md:pb-8 flex flex-col justify-between">

    <!-- TOP: ARTIST HEADER -->
    <div class="shrink-0 mb-2 md:mb-3">
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter">
        IHEIZ
      </h2>
      <p class="text-xs md:text-sm font-bold uppercase tracking-widest text-white/70 mt-0.5">
        Techno
      </p>
    </div>

    <!-- MITTE: BIO MIT LINKSBÜNDIGEM CUSTOM-SCROLLBAR (FLEX-1) -->
    <div class="relative flex-1 min-h-0 my-2 flex">
      <!-- SWIPER-STYLE SCROLLBAR AUF DER LINKEN SEITE -->
      <div
        id="bio-scrollbar-track"
        class="absolute left-0 top-1 bottom-1 w-[2px] bg-white/15 rounded-full pointer-events-none transition-opacity duration-300 opacity-0 z-10"
        aria-hidden="true"
      >
        <div
          id="bio-scrollbar-thumb"
          class="w-full bg-white/80 rounded-full will-change-transform"
          style="height: 0px; transform: translateY(0px);"
        ></div>
      </div>

      <!-- SCROLL-CONTAINER (NATIVE SCROLLBARS VERSTECKT; Abstände über .bio-p) -->
      <div
        id="bio-scroll-container"
        class="w-full h-full overflow-y-auto pl-4 pr-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden select-text"
        tabindex="0"
        aria-label="Biography"
      >
        <p class="bio-p bio-tagline">
          My passion for raw, minimalist 90<span class="lowercase">s</span>-style techno has been the core concept behind this project since the early 2000<span class="lowercase">s</span>.
        </p>
        <p class="bio-p text-sm md:text-base text-white/80 leading-relaxed font-extralight">
          My name is Ingo Beitz. I fell under the spell of electronic music back in 1985. I experienced the birth of Techno firsthand and have been actively producing within the genre since 1996. Before that, I released music under the alias <em>kAlte fArben</em>, dropping two albums, an EP, and numerous remixes rooted in heavy, uncompromising EBM and Industrial. In collaboration with Wolfgang Kaiser—who is still active today, primarily as Monococ—I also produced a series of Trance and Hard Trance vinyl records under various other pseudonyms.
        </p>
        <p class="bio-p text-sm md:text-base text-white/80 leading-relaxed font-extralight">
          As IHEIZ (initially launched as Inge Heiz), I contributed several releases to INTOXIK during the golden era of netlabels. For Native Instruments’ launch of Traktor Pro 3, I produced a dedicated promotional track (<em>Schwarzlichthauch</em>), driven primarily by their Softsynth Absynth and the hybrid Hard-/Software Instrument KORE.
        </p>
        <p class="bio-p text-sm md:text-base text-white/80 leading-relaxed font-extralight">
          Then, life happened.
        </p>
        <p class="bio-p text-sm md:text-base text-white/80 leading-relaxed font-extralight">
          And now? I’m ready to go all-in. Neither IHEIZ nor kAlte fArben ever faded from my creative drive. The time has come to bring all those accumulated ideas to life. This passion for electronic music is something I’ll never shake—it is a part of who I am, and I burn for it.
        </p>
      </div>
    </div>

    <!-- UNTEN: SPECS / FACTS -->
    <div class="shrink-0 mt-3">
      <div class="grid grid-cols-2 gap-2.5">
        <div class="border border-white/30 p-2.5 bg-black/20">
          <p class="text-[11px] md:text-xs font-mono uppercase text-white/50 tracking-wider">BPM Range</p>
          <p class="text-xs md:text-sm font-bold mt-0.5">In this Demo: 136 — 142</p>
        </div>
        <div class="border border-white/30 p-2.5 bg-black/20">
          <p class="text-[11px] md:text-xs font-mono uppercase text-white/50 tracking-wider">Licensing</p>
          <p class="text-xs md:text-sm font-bold mt-0.5">Release Ready</p>
        </div>
        <div class="border border-white/30 p-2.5 bg-black/20">
          <p class="text-[11px] md:text-xs font-mono uppercase text-white/50 tracking-wider">DAW / Hardware</p>
          <p class="text-xs md:text-sm font-bold mt-0.5 line-clamp-2">Ableton / Cubase / TB-303 / MASCHINE / Elektrons / Outboard</p>
        </div>
        <div class="border border-white/30 p-2.5 bg-black/20">
          <p class="text-[11px] md:text-xs font-mono uppercase text-white/50 tracking-wider">Location</p>
          <p class="text-xs md:text-sm font-bold mt-0.5">Moved from Berlin to Outbacks (WÜ, DE)</p>
        </div>
      </div>
    </div>

    <!-- BOTTOM: DIRECT CONTACT -->
    <div class="shrink-0 mt-3 pt-3 md:mt-4 md:pt-4 border-t border-white/10">
      <p class="text-[11px] font-mono uppercase tracking-widest text-white/50 mb-2">Contact</p>

      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
        <a
          href="mailto:info@iheiz.com"
          class="parallelogram-btn bg-white hover:bg-white/90 text-black font-black text-xs uppercase tracking-wider px-5 py-2.5 transition-transform hover:scale-105 active:scale-95 flex items-center gap-2 cursor-pointer shadow-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Email me
        </a>

        <a
          href="https://soundcloud.com/iheiz-shares-some-tunes"
          target="_blank"
          rel="noopener noreferrer"
          class="parallelogram-btn bg-white/10 hover:bg-white text-white hover:text-black font-black text-xs uppercase tracking-wider px-4 py-2.5 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          More Stuff on SoundCloud
        </a>
      </div>
    </div>

  </div>
</aside>

<style>
  /* DESKTOP-SCHIENEN-WINKEL */
  @media (min-width: 768px) {
    #info-overlay {
      width: calc(50vw + 15vw);
      clip-path: polygon(0% 0%, 100% 0%, calc(100% - 15vw) 100%, 0% 100%);
      transform: translateX(calc(-65vw + 90px));
      will-change: transform;
    }
  }

  /* MOBILE-SCHIENEN-WINKEL */
  @media (max-width: 767px) {
    #info-overlay {
      width: 100%;
      height: calc(100dvh + 4vh);
      clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 4vh), 0% 100%);
      transform: translateY(-106%);
      will-change: transform;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const DESKTOP = '(min-width: 768px)';
  const PEEK_WIDTH = 90; // sichtbare Spitze des geschlossenen Overlays (Desktop)

  const overlay = document.querySelector<HTMLElement>('#info-overlay');
  const contentBox = document.querySelector<HTMLElement>('#info-overlay .info-content-box');
  const triggerBtn = document.querySelector<HTMLButtonElement>('#info-trigger-btn');
  const iconWrapper = document.querySelector<HTMLElement>('#info-icon-wrapper');
  const backdrop = document.querySelector<HTMLElement>('#info-backdrop');

  const bioContainer = document.querySelector<HTMLElement>('#bio-scroll-container');
  const scrollTrack = document.querySelector<HTMLElement>('#bio-scrollbar-track');
  const scrollThumb = document.querySelector<HTMLElement>('#bio-scrollbar-thumb');

  if (!overlay || !contentBox || !triggerBtn || !iconWrapper || !backdrop || !bioContainer || !scrollTrack || !scrollThumb) {
    throw new Error('InfoOverlay: Erforderliche DOM-Elemente fehlen.');
  }

  let isOpen = false;
  const isDesktop = () => window.matchMedia(DESKTOP).matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Stabile Transformation auf dem HTML-Wrapper
  gsap.set(iconWrapper, { transformOrigin: "50% 50%" });

  // HERZSCHLAG-PULS TIMELINE (entfällt bei „Bewegung reduzieren“)
  const heartbeatTl = gsap.timeline({
    repeat: -1,
    repeatDelay: 5,
    delay: 0.8,
    paused: reducedMotion,
  });

  heartbeatTl
    .to(iconWrapper, { scale: 1.25, duration: 0.12, ease: "power1.out" })
    .to(iconWrapper, { scale: 1.05, duration: 0.08, ease: "power1.in" })
    .to(iconWrapper, { scale: 1.35, duration: 0.14, ease: "power1.out" })
    .to(iconWrapper, { scale: 1.0, duration: 0.25, ease: "power2.inOut" });

  // --- CUSTOM SCROLLBAR LOGIK ---
  function updateScrollbar() {
    if (!bioContainer || !scrollTrack || !scrollThumb) return;

    const clientHeight = bioContainer.clientHeight;
    const scrollHeight = bioContainer.scrollHeight;
    const scrollTop = bioContainer.scrollTop;

    if (scrollHeight <= clientHeight + 2) {
      scrollTrack.style.opacity = '0';
      return;
    }

    scrollTrack.style.opacity = '1';

    const trackHeight = scrollTrack.clientHeight;
    const ratio = clientHeight / scrollHeight;
    const thumbHeight = Math.max(trackHeight * ratio, 20);
    const maxScroll = scrollHeight - clientHeight;
    const maxThumbTravel = trackHeight - thumbHeight;

    const scrollFraction = maxScroll > 0 ? scrollTop / maxScroll : 0;
    const thumbTop = scrollFraction * maxThumbTravel;

    scrollThumb.style.height = `${thumbHeight}px`;
    scrollThumb.style.transform = `translateY(${thumbTop}px)`;
  }

  bioContainer.addEventListener('scroll', updateScrollbar, { passive: true });

  const resizeObserver = new ResizeObserver(() => {
    updateScrollbar();
  });
  resizeObserver.observe(bioContainer);

  // --- DRAWER POSITIONIERUNG (am Element gemessen, unabhängig vom Pinch-Zoom) ---
  function getClosedX(): number {
    return -overlay!.offsetWidth + PEEK_WIDTH;
  }

  function getClosedY(): number {
    return -overlay!.offsetHeight * 1.04;
  }

  function initLayout() {
    gsap.killTweensOf(overlay);

    if (!isOpen) {
      if (isDesktop()) {
        gsap.set(overlay, { x: getClosedX(), y: 0 });
      } else {
        gsap.set(overlay, { x: 0, y: getClosedY() });
      }
    } else {
      gsap.set(overlay, { x: 0, y: 0 });
    }

    updateScrollbar();
  }

  initLayout();
  window.addEventListener('resize', initLayout);

  /** Barrierefreiheit: Overlay-Inhalt nur offen erreichbar, Seite dahinter nur geschlossen. */
  function setAccessibilityState(open: boolean) {
    triggerBtn!.setAttribute('aria-expanded', String(open));
    contentBox!.inert = !open;
    document.body.classList.toggle('info-open', open);
    document.querySelectorAll<HTMLElement>('.sliding-panel, #reset-btn').forEach((el) => {
      el.inert = open;
    });
  }

  function openOverlay() {
    isOpen = true;
    setAccessibilityState(true);
    heartbeatTl.pause();
    gsap.killTweensOf(iconWrapper);

    const tl = gsap.timeline({
      onComplete: () => {
        updateScrollbar();
      }
    });

    tl.to(backdrop, { opacity: 1, pointerEvents: "auto", duration: 0.4 }, 0)
      .to(iconWrapper, { rotation: 45, scale: 1, duration: 0.35, ease: "back.out(1.7)" }, 0);

    if (isDesktop()) {
      tl.to(overlay, { x: 0, duration: 0.6, ease: "power3.inOut" }, 0);
    } else {
      tl.to(overlay, { y: 0, duration: 0.6, ease: "power3.inOut" }, 0);
    }
    if (reducedMotion) tl.timeScale(6);
  }

  function closeOverlay() {
    isOpen = false;
    setAccessibilityState(false);
    const tl = gsap.timeline({
      onComplete: () => {
        if (!reducedMotion) heartbeatTl.play(0);
      }
    });

    tl.to(backdrop, { opacity: 0, pointerEvents: "none", duration: 0.3 }, 0)
      .to(iconWrapper, { rotation: 0, scale: 1, duration: 0.35, ease: "power2.inOut" }, 0);

    if (isDesktop()) {
      tl.to(overlay, { x: getClosedX(), duration: 0.5, ease: "power3.inOut" }, 0);
    } else {
      tl.to(overlay, { y: getClosedY(), duration: 0.5, ease: "power3.inOut" }, 0);
    }
    if (reducedMotion) tl.timeScale(6);
  }

  triggerBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isOpen) {
      closeOverlay();
    } else {
      openOverlay();
    }
  });

  backdrop.addEventListener('click', closeOverlay);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      e.preventDefault(); // Signal an index.astro: Escape ist bereits verarbeitet
      closeOverlay();
      triggerBtn.focus();
    }
  });
</script>
