---
// src/components/TrackPanel.astro
import type { TrackConfig } from '../types/track';
import { Image } from 'astro:assets';
import WaveformPlayer from './WaveformPlayer.astro';
import TrackArtwork from './TrackArtwork.astro';

interface Props {
  track: TrackConfig;
}

const { track } = Astro.props;

// Im Frontmatter von TrackPanel.astro:
// const isFeatured = track.id === 2;
const isFeatured = Boolean(track.isFeatured);
---

<section 
  id={`panel-${track.id}`} 
  data-index={track.id} 
  class={`sliding-panel absolute bg-gradient-to-br ${track.gradient} flex flex-col items-center justify-center overflow-hidden select-none ${track.id === 2 ? 'z-20' : 'z-10'}`}
  style={`--track-accent: ${track.accentColor};`}
>
  <!-- ASTRO AUTOMATISCH OPTIMIERTES HINTERGRUNDBILD -->
  {track.bgImage && (
    <Image
      src={track.bgImage}
      alt=""
      aria-hidden="true"
      width={1920}
      format="webp"
      quality={80}
      loading="eager"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover mix-blend-luminosity will-change-transform"
      style={{ opacity: track.bgOpacity ?? 0.15 }}
    />
  )}

  <!-- SUBTILE VIGNETTE -->
  <div class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,0.65)_100%)]" />

  <!-- ARTWORK-LAYER IM HINTERGRUND -->
  <TrackArtwork
    trackId={track.id}
    accentColor={track.accentColor}
    bgNumber={track.bgNumber}
    isFeatured={isFeatured}
  />

<!-- CONTENT & PLAYER LAYER (Bereits vertikal & horizontal zentriert) -->
  <div class="panel-content w-full h-full flex flex-col items-center justify-center relative px-4 sm:px-6 pointer-events-none z-10">
    <div class="header-group text-center pointer-events-auto">
      <h2 
        class:list={[
          'font-black uppercase tracking-tighter transition-all',
          isFeatured 
            ? 'text-4xl sm:text-6xl md:text-7xl 2xl:text-8xl' 
            : 'text-3xl sm:text-5xl md:text-6xl 2xl:text-7xl'
        ]}
      >
        {track.title}
      </h2>
      <p 
        class:list={[
          'font-bold uppercase tracking-widest text-white/80 transition-all',
          isFeatured 
            ? 'text-sm sm:text-base 2xl:text-lg mt-1.5 sm:mt-2.5' 
            : 'text-xs sm:text-sm 2xl:text-base mt-1 sm:mt-2'
        ]}
      >
        {track.subtitle}
      </p>
    </div>

    <WaveformPlayer 
      audioUrl={track.audio} 
      accentColor={track.accentColor} 
      download={track.download} 
    />
  </div>
</section>

<style>
  /* DESKTOP-SCHIENEN-SYSTEM (Vertikale Schrägen) */
  @media (min-width: 768px) {
    .sliding-panel {
      clip-path: polygon(15vw 0%, 100% 0%, calc(100% - 15vw) 100%, 0% 100%);
      -webkit-clip-path: polygon(15vw 0%, 100% 0%, calc(100% - 15vw) 100%, 0% 100%);
      width: 55vw;
      height: 100%;
      isolation: isolate;
      will-change: transform, width, clip-path;
    }
    :global(#panel-1) { left: 0; transform-origin: left center; }
    :global(#panel-2) { left: 50%; }
    :global(#panel-3) { right: 0; transform-origin: right center; }
  }

  /* MOBILE-SCHIENEN-SYSTEM (Horizontale Schrägen) */
  @media (max-width: 767px) {
    .sliding-panel {
      width: 100%;
      left: 0;
      isolation: isolate;
      will-change: transform, height, clip-path;
    }
    :global(#panel-1) {
      clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 4vh), 0% 100%);
      -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 4vh), 0% 100%);
    }
    :global(#panel-2) {
      clip-path: polygon(0% 4vh, 100% 0%, 100% calc(100% - 4vh), 0% 100%);
      -webkit-clip-path: polygon(0% 4vh, 100% 0%, 100% calc(100% - 4vh), 0% 100%);
    }
    :global(#panel-3) {
      clip-path: polygon(0% 4vh, 100% 0%, 100% 100%, 0% 100%);
      -webkit-clip-path: polygon(0% 4vh, 100% 0%, 100% 100%, 0% 100%);
    }
  }

  .sliding-panel {
    cursor: pointer;
  }
  :global(body.is-expanded) .sliding-panel {
    cursor: default;
  }
</style>