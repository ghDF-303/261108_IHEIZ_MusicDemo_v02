---
// src/pages/index.astro
import '../styles/global.css';
import { tracks } from '../data/tracks';
import Preloader from '../components/Preloader.astro';
import TrackPanel from '../components/TrackPanel.astro';
import InfoOverlay from '../components/InfoOverlay.astro';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>IHEIZ - Music Demo</title>
    <link 
      rel="preload" 
      href="/fonts/inter-v20-latin-regular.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/fonts/inter-v20-latin-200.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/fonts/inter-v20-latin-700.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <link 
      rel="preload" 
      href="/fonts/inter-v20-latin-900.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
    <style>
      #reset-btn {
        clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
        -webkit-clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
      }
    </style>
  </head>
  <body class="bg-black text-white h-screen overflow-hidden select-none">

    <main class="relative w-full h-full overflow-hidden flex flex-col md:flex-row items-center">

      <!-- Artist & Promo Info Overlay -->
      <InfoOverlay />

      {tracks.map((track) => (
        <TrackPanel track={track} />
      ))}

      <button 
        id="reset-btn" 
        class="absolute bottom-[-100px] left-1/2 transform -translate-x-1/2 z-30 bg-white text-black font-black text-xs sm:text-sm uppercase tracking-widest px-6 py-3 sm:px-10 sm:py-4 shadow-2xl flex items-center gap-2 cursor-pointer hover:scale-105 active:scale-95 transition-transform opacity-0"
      >
        <!-- <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg> -->
        Back
      </button>
    </main>

<script>
      import { gsap } from "gsap";

      const resetBtn = document.querySelector<HTMLButtonElement>('#reset-btn');
      const headerGroups = document.querySelectorAll<HTMLElement>('.header-group');
      const panels = document.querySelectorAll<HTMLElement>('.sliding-panel');
      const audioPlayers = document.querySelectorAll<HTMLElement>('.audio-player');
      
      let isExpanded = false;

      if (!resetBtn) throw new Error('#reset-btn fehlt im DOM');

      // 1. ORGANISCHER SCHWEBEMODUS MIT ZUFALLSWERTEN PRO PANEL
      const rnd = (min: number, max: number) => gsap.utils.random(min, max);

      panels.forEach(panel => {
        const mid = panel.querySelector<HTMLElement>('.hud-layer, .layer-mid');
        const fg = panel.querySelector<HTMLElement>('.hero-layer, .layer-fg');

        if (mid) {
          gsap.to(mid, {
            x: rnd(-22, 22),
            duration: rnd(4.8, 6.8),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: rnd(0, 1.5)
          });

          gsap.to(mid, {
            y: rnd(-16, 16),
            duration: rnd(3.8, 5.4),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: rnd(0, 1.2)
          });

          gsap.to(mid, {
            rotation: rnd(-7, 7),
            duration: rnd(6.5, 9.0),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            transformOrigin: "50% 50%"
          });
        }

        if (fg) {
          gsap.to(fg, {
            x: rnd(-14, 14),
            duration: rnd(3.6, 5.0),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: rnd(0.2, 1.0)
          });

          gsap.to(fg, {
            y: rnd(-18, 18),
            duration: rnd(2.9, 4.2),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: rnd(0, 0.8)
          });

          gsap.to(fg, {
            scale: rnd(1.04, 1.08),
            duration: rnd(3.0, 4.0),
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            transformOrigin: "50% 50%"
          });
        }
      });

      function initLayout() {
        const isDesktop = window.innerWidth >= 768;
        gsap.killTweensOf(["#panel-1", "#panel-2", "#panel-3"]);
        
        if (isDesktop) {
          gsap.set("#panel-1", { x: "-10vw", width: "55vw", height: "100%", y: "0vh" });
          gsap.set("#panel-2", { x: "0vw", width: "55vw", height: "100%", y: "0vh", left: "50%", xPercent: -50, transformOrigin: "50% 50%" });
          gsap.set("#panel-3", { x: "10vw", width: "55vw", height: "100%", y: "0vh" });
        } else {
          gsap.set("#panel-1", { x: 0, y: "0vh", width: "100%", height: "36vh" });
          gsap.set("#panel-2", { x: 0, y: "32vh", width: "100%", height: "36vh", left: 0, xPercent: 0 });
          gsap.set("#panel-3", { x: 0, y: "64vh", width: "100%", height: "36vh" });
        }
      }

      initLayout();
      window.addEventListener('resize', () => { if (!isExpanded) initLayout(); });

      // CLICK EXPANSION
      panels.forEach(panel => {
        panel.addEventListener('click', () => {
          if (isExpanded) return;
          isExpanded = true;
          document.body.classList.add('is-expanded');
          
          const index = panel.getAttribute('data-index');
          const isDesktop = window.innerWidth >= 768;
          const activePlayer = panel.querySelector<HTMLElement>('.audio-player');
          const activeHeader = panel.querySelector<HTMLElement>('.header-group');
          const activeArtwork = panel.querySelector<HTMLElement>('.track-artwork-container, .track-artwork');
          const activeBgImage = panel.querySelector<HTMLImageElement>('img');
          
          const tl = gsap.timeline({
            defaults: {
              duration: 0.75,
              ease: "power3.out" // Einheitlicher, flüssiger Antritt für alle Layer
            }
          });

          // Header anderer Panels ausblenden
          headerGroups.forEach(h => {
            if (!panel.contains(h)) gsap.to(h, { opacity: 0, scale: 0.9, duration: 0.3 });
          });

          // Artworks anderer Panels ausblenden
          panels.forEach(p => {
            if (p !== panel) {
              const otherArtwork = p.querySelector<HTMLElement>('.track-artwork-container, .track-artwork');
              if (otherArtwork) gsap.to(otherArtwork, { opacity: 0, duration: 0.35 });
            }
          });

          // 1. AKTIVES ARTWORK ZOOMEN (synchron ab T=0)
          if (activeArtwork) {
            tl.to(activeArtwork, {
              scale: isDesktop ? 1.25 : 1.15,
              opacity: 1,
              y: isDesktop ? -20 : -10
            }, 0);
          }

          // 2. AKTIVES HINTERGRUNDBILD AKTIV ZOOMEN (verhindert den verspäteten Layout-Ruckler)
          if (activeBgImage) {
            tl.to(activeBgImage, {
              scale: 1.08,
              transformOrigin: "center center"
            }, 0);
          }

          // 3. SCHIENEN-EXPANSION (alle synchron auf power3.out)
          if (isDesktop) {
            if (index === "1") {
              tl.to("#panel-1", { x: "0vw", width: "140vw" }, 0);
              tl.to("#panel-2", { x: "100vw" }, 0);
              tl.to("#panel-3", { x: "132.5vw" }, 0);
            } else if (index === "2") {
              tl.to("#panel-1", { x: "-100vw" }, 0);
              tl.to("#panel-2", { width: "100vw" }, 0);
              tl.to("#panel-3", { x: "100vw" }, 0);
            } else if (index === "3") {
              tl.to("#panel-3", { x: "0vw", width: "140vw" }, 0);
              tl.to("#panel-2", { x: "-100vw" }, 0);
              tl.to("#panel-1", { x: "-132.5vw" }, 0);
            }
          } else {
            if (index === "1") {
              tl.to("#panel-1", { y: "0vh", height: "104vh" }, 0);
              tl.to("#panel-2", { y: "100vh" }, 0);
              tl.to("#panel-3", { y: "132vh" }, 0);
            } else if (index === "2") {
              tl.to("#panel-1", { y: "-36vh" }, 0);
              tl.to("#panel-2", { y: "-4vh", height: "108vh" }, 0);
              tl.to("#panel-3", { y: "100vh" }, 0);
            } else if (index === "3") {
              tl.to("#panel-1", { y: "-68vh" }, 0);
              tl.to("#panel-2", { y: "-36vh" }, 0);
              tl.to("#panel-3", { y: "-4vh", height: "104vh" }, 0);
            }
          }

          // HEADER VERSETZEN
          if (activeHeader) {
            const shiftY = isDesktop 
              ? (window.innerHeight > 1200 ? -100 : -70) 
              : (window.innerHeight < 680 ? -55 : -85);

            tl.to(activeHeader, { 
              y: shiftY, 
              duration: 0.5, 
              ease: "power2.out" 
            }, "-=0.35");
          }

          // PLAYER EINBLENDEN
          if (activePlayer) {
            tl.to(activePlayer, {
              opacity: 1,
              y: 0,
              duration: 0.45,
              ease: "power2.out",
              onStart: () => { activePlayer.style.pointerEvents = "auto"; }
            }, "-=0.3");
          }

          const resetBottom = window.innerHeight < 680 ? "24px" : "40px";
          tl.to(resetBtn, { bottom: resetBottom, opacity: 1, duration: 0.45, ease: "back.out(1.4)" }, "-=0.25");
        });
      });

      // RESET
      resetBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('track:fade-active'));

        audioPlayers.forEach(p => {
          p.style.pointerEvents = "none";
          gsap.to(p, { opacity: 0, y: 24, duration: 0.25 });
        });

        const tl = gsap.timeline({ 
          defaults: {
            duration: 0.6,
            ease: "power3.out"
          },
          onComplete: () => { 
            isExpanded = false; 
            document.body.classList.remove('is-expanded');
          } 
        });
        
        tl.to(resetBtn, { bottom: "-100px", opacity: 0, duration: 0.3, ease: "power2.in" });
        
        headerGroups.forEach(h => {
          gsap.to(h, { y: 0, opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" });
        });

        // ARTWORKS & HINTERGRÜNDE ZURÜCKSETZEN
        panels.forEach(p => {
          const artwork = p.querySelector<HTMLElement>('.track-artwork-container, .track-artwork');
          const bgImg = p.querySelector<HTMLImageElement>('img');
          
          if (artwork) {
            gsap.to(artwork, { scale: 1, opacity: 1, y: 0, duration: 0.6, ease: "power3.out" });
          }
          if (bgImg) {
            gsap.to(bgImg, { scale: 1, duration: 0.6, ease: "power3.out" });
          }
        });

        const isDesktop = window.innerWidth >= 768;

        if (isDesktop) {
          tl.to("#panel-1", { x: "-10vw", width: "55vw" }, 0);
          tl.to("#panel-2", { x: "0vw", width: "55vw" }, 0);
          tl.to("#panel-3", { x: "10vw", width: "55vw" }, 0);
        } else {
          tl.to("#panel-1", { y: "0vh", height: "36vh" }, 0);
          tl.to("#panel-2", { y: "32vh", height: "36vh" }, 0);
          tl.to("#panel-3", { y: "64vh", height: "36vh" }, 0);
        }
      });
    </script>

    <Preloader demoTitle="Analogue Session & More" />

  </body>
</html>