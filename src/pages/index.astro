---
import { tracks } from '../data/tracks';
import Preloader from '../components/Preloader.astro';
import TrackPanel from '../components/TrackPanel.astro';
import InfoOverlay from '../components/InfoOverlay.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="IHEIZ - Music Demo">
  <main id="stage" class="relative w-full h-full overflow-hidden flex flex-col md:flex-row items-center">
    <h1 class="sr-only">IHEIZ – Music Demo</h1>

    <!-- Artist & Promo Info Overlay -->
    <InfoOverlay />

    {tracks.map((track, index) => (
      <TrackPanel track={track} index={index} total={tracks.length} />
    ))}

    <button
      id="reset-btn"
      type="button"
      class="invisible absolute bottom-[-100px] left-1/2 transform -translate-x-1/2 z-30 bg-white text-black font-black text-xs sm:text-sm uppercase tracking-widest px-6 py-3 sm:px-10 sm:py-4 shadow-2xl flex items-center gap-2 cursor-pointer hover:scale-105 active:scale-95 transition-transform opacity-0"
    >
      Back
    </button>
  </main>

  <Preloader demoTitle="Analogue Session & More" />
</BaseLayout>

<style>
  #reset-btn {
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
  }
</style>

<script>
  import { gsap } from "gsap";

  /*
   * LAYOUT-GEOMETRIE
   * Alle Werte in Prozent der Bühnenbreite (Desktop) bzw. -höhe (Mobile).
   * Bei 3 Tracks ergeben sie exakt das ursprüngliche Layout; bei mehr oder weniger
   * Tracks werden Breite/Höhe und Abstände proportional berechnet.
   */
  const DESKTOP_START = -10;              // linke Kante des ersten Panels
  const DESKTOP_SPAN = 120;               // Panels reichen von -10 bis 110
  const DESKTOP_WIDTH_RATIO = 55 / 32.5;  // Panelbreite : Abstand (3 Tracks: 55 : 32.5)
  const DESKTOP_EXPANDED_EDGE = 140;      // Breite des geöffneten ersten/letzten Panels
  const DESKTOP_OFFSCREEN_GAP = 22.5;     // Abstand der weggeschobenen Panels zum Rand
  const MOBILE_OVERLAP = 4;               // Überlappung = Schräge (siehe --slant in TrackPanel)

  const BREAKPOINT = '(min-width: 768px)';
  const REDUCED_MOTION = '(prefers-reduced-motion: reduce)';

  interface Box { x: number; y: number; width: number; height: number }
  interface Viewport { desktop: boolean; w: number; h: number }

  const stage = document.querySelector<HTMLElement>('#stage');
  const resetBtn = document.querySelector<HTMLButtonElement>('#reset-btn');
  if (!stage || !resetBtn) throw new Error('#stage oder #reset-btn fehlt im DOM');

  const panels = Array.from(document.querySelectorAll<HTMLElement>('.sliding-panel'));
  const count = panels.length;

  const parts = panels.map((panel) => ({
    panel,
    header: panel.querySelector<HTMLElement>('.header-group'),
    player: panel.querySelector<HTMLElement>('.audio-player'),
    playBtn: panel.querySelector<HTMLButtonElement>('.btn-play'),
    openBtn: panel.querySelector<HTMLButtonElement>('.panel-open-btn'),
    artwork: panel.querySelector<HTMLElement>('.track-artwork-container'),
    bgImage: panel.querySelector<HTMLImageElement>('img'),
    hud: panel.querySelector<HTMLElement>('.hud-layer'),
    hero: panel.querySelector<HTMLElement>('.hero-layer'),
  }));

  const prefersReducedMotion = () => window.matchMedia(REDUCED_MOTION).matches;

  // Gemessen an der Bühne (nicht window.inner*): stimmt mit 100dvh überein und
  // ändert sich nicht beim Pinch-Zoom auf Mobilgeräten.
  function viewport(): Viewport {
    return {
      desktop: window.matchMedia(BREAKPOINT).matches,
      w: stage!.clientWidth,
      h: stage!.clientHeight,
    };
  }

  // ---------- Geometrie ----------

  function desktopMetrics() {
    const step = DESKTOP_SPAN / (count - 1 + DESKTOP_WIDTH_RATIO);
    return { step, width: step * DESKTOP_WIDTH_RATIO };
  }

  function mobileMetrics() {
    const step = (100 - MOBILE_OVERLAP) / count;
    return { step, height: count === 1 ? 100 : step + MOBILE_OVERLAP };
  }

  /** Zugeklappt: alle Panels nebeneinander (Desktop) bzw. übereinander (Mobile). */
  function collapsedBox(i: number, vp: Viewport): Box {
    const pw = vp.w / 100;
    const ph = vp.h / 100;
    if (vp.desktop) {
      const { step, width } = desktopMetrics();
      return { x: (DESKTOP_START + i * step) * pw, y: 0, width: width * pw, height: vp.h };
    }
    const { step, height } = mobileMetrics();
    return { x: 0, y: i * step * ph, width: vp.w, height: height * ph };
  }

  /** Aufgeklappt: Panel `active` füllt den Screen, die anderen weichen nach außen aus. */
  function expandedBox(i: number, active: number, vp: Viewport): Box {
    const pw = vp.w / 100;
    const ph = vp.h / 100;
    const isFirst = active === 0;
    const isLast = active === count - 1;

    if (vp.desktop) {
      const { width } = desktopMetrics();
      if (i === active) {
        if (isFirst) return { x: 0, y: 0, width: DESKTOP_EXPANDED_EDGE * pw, height: vp.h };
        if (isLast) return { x: (100 - DESKTOP_EXPANDED_EDGE) * pw, y: 0, width: DESKTOP_EXPANDED_EDGE * pw, height: vp.h };
        return { x: 0, y: 0, width: 100 * pw, height: vp.h };
      }
      const x = i < active
        ? -DESKTOP_OFFSCREEN_GAP - width * (active - i)
        : 100 + DESKTOP_OFFSCREEN_GAP + width * (i - active - 1);
      return { x: x * pw, y: 0, width: width * pw, height: vp.h };
    }

    const { step, height } = mobileMetrics();
    if (i === active) {
      if (count === 1) return { x: 0, y: 0, width: vp.w, height: vp.h };
      if (isFirst) return { x: 0, y: 0, width: vp.w, height: (100 + MOBILE_OVERLAP) * ph };
      if (isLast) return { x: 0, y: -MOBILE_OVERLAP * ph, width: vp.w, height: (100 + MOBILE_OVERLAP) * ph };
      return { x: 0, y: -MOBILE_OVERLAP * ph, width: vp.w, height: (100 + 2 * MOBILE_OVERLAP) * ph };
    }
    const y = i < active
      ? -height - step * (active - 1 - i)
      : 100 + step * (i - active - 1);
    return { x: 0, y: y * ph, width: vp.w, height: height * ph };
  }

  const headerShift = (vp: Viewport) =>
    vp.desktop ? (vp.h > 1200 ? -100 : -70) : (vp.h < 680 ? -55 : -85);
  const resetBottom = (vp: Viewport) => (vp.h < 680 ? 24 : 40);
  const artworkZoom = (vp: Viewport) =>
    vp.desktop ? { scale: 1.25, y: -20 } : { scale: 1.15, y: -10 };

  // ---------- Schwebemodus (dekorativ) ----------

  const rnd = (min: number, max: number) => gsap.utils.random(min, max);
  const floatTweens: gsap.core.Tween[][] = parts.map(() => []);

  if (!prefersReducedMotion()) {
    parts.forEach(({ hud, hero }, i) => {
      const loop = { repeat: -1, yoyo: true, ease: "sine.inOut" };
      if (hud) {
        floatTweens[i].push(
          gsap.to(hud, { ...loop, x: rnd(-22, 22), duration: rnd(4.8, 6.8), delay: rnd(0, 1.5) }),
          gsap.to(hud, { ...loop, y: rnd(-16, 16), duration: rnd(3.8, 5.4), delay: rnd(0, 1.2) }),
          gsap.to(hud, { ...loop, rotation: rnd(-7, 7), duration: rnd(6.5, 9.0), transformOrigin: "50% 50%" }),
        );
      }
      if (hero) {
        floatTweens[i].push(
          gsap.to(hero, { ...loop, x: rnd(-14, 14), duration: rnd(3.6, 5.0), delay: rnd(0.2, 1.0) }),
          gsap.to(hero, { ...loop, y: rnd(-18, 18), duration: rnd(2.9, 4.2), delay: rnd(0, 0.8) }),
          gsap.to(hero, { ...loop, scale: rnd(1.04, 1.08), duration: rnd(3.0, 4.0), transformOrigin: "50% 50%" }),
        );
      }
    });
  }

  // Unsichtbare Panels müssen nicht weiter animiert werden
  const pauseFloatsExcept = (active: number) =>
    floatTweens.forEach((list, i) => { if (i !== active) list.forEach((t) => t.pause()); });
  const resumeFloats = () => floatTweens.forEach((list) => list.forEach((t) => t.resume()));

  // ---------- Zustand ----------

  let activeIndex: number | null = null;   // null = zugeklappt
  let busy = false;                        // Animation läuft
  let currentTl: gsap.core.Timeline | null = null;

  /** Setzt Position/Größe aller Panels und die größenabhängigen Werte ohne Animation. */
  function applyLayout() {
    const vp = viewport();
    parts.forEach(({ panel }, i) => {
      gsap.set(panel, activeIndex === null ? collapsedBox(i, vp) : expandedBox(i, activeIndex, vp));
    });

    if (activeIndex !== null) {
      const active = parts[activeIndex];
      if (active.artwork) gsap.set(active.artwork, artworkZoom(vp));
      if (active.header) gsap.set(active.header, { y: headerShift(vp) });
      gsap.set(resetBtn, { bottom: resetBottom(vp) });
    }
  }

  applyLayout();

  // Größenänderung / Drehen – auch im geöffneten Zustand
  let resizeFrame = 0;
  let lastSize = `${stage.clientWidth}x${stage.clientHeight}`;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(() => {
      const size = `${stage.clientWidth}x${stage.clientHeight}`;
      if (size === lastSize) return;
      lastSize = size;
      currentTl?.progress(1); // laufende Animation sofort beenden
      applyLayout();
    });
  });

  // ---------- Aufklappen ----------

  function expand(index: number, viaKeyboard: boolean) {
    if (activeIndex !== null || busy) return;
    activeIndex = index;
    busy = true;
    document.body.classList.add('is-expanded');

    const vp = viewport();
    const active = parts[index];
    active.player?.dispatchEvent(new Event('track:activate'));
    pauseFloatsExcept(index);

    const tl = gsap.timeline({
      defaults: { duration: 0.75, ease: "power3.out" },
      onComplete: () => {
        busy = false;
        currentTl = null;
        if (viaKeyboard) active.playBtn?.focus({ preventScroll: true });
      },
    });
    currentTl = tl;

    // Header und Artworks der anderen Panels ausblenden
    parts.forEach((p, i) => {
      if (i === index) return;
      if (p.header) tl.to(p.header, { opacity: 0, scale: 0.9, duration: 0.3 }, 0);
      if (p.artwork) tl.to(p.artwork, { opacity: 0, duration: 0.35 }, 0);
    });

    // Aktives Artwork und Hintergrundbild zoomen
    if (active.artwork) tl.to(active.artwork, { ...artworkZoom(vp), opacity: 1 }, 0);
    if (active.bgImage) tl.to(active.bgImage, { scale: 1.08, transformOrigin: "center center" }, 0);

    // Schienen-Expansion
    parts.forEach(({ panel }, i) => tl.to(panel, expandedBox(i, index, vp), 0));

    // Header versetzen, Player und Back-Button einblenden
    if (active.header) tl.to(active.header, { y: headerShift(vp), duration: 0.5, ease: "power2.out" }, 0.4);
    if (active.player) {
      const player = active.player;
      tl.to(player, {
        autoAlpha: 1,
        y: 0,
        duration: 0.45,
        ease: "power2.out",
        onStart: () => { player.style.pointerEvents = "auto"; },
      }, 0.6);
    }
    tl.to(resetBtn, { bottom: resetBottom(vp), autoAlpha: 1, duration: 0.45, ease: "back.out(1.4)" }, 0.8);

    if (prefersReducedMotion()) tl.timeScale(6);
  }

  panels.forEach((panel, i) => {
    // detail === 0: Klick wurde per Tastatur (Enter/Leertaste) ausgelöst
    panel.addEventListener('click', (e) => expand(i, e.detail === 0));
  });

  // ---------- Zuklappen ----------

  function collapse() {
    if (activeIndex === null) return;
    const previous = parts[activeIndex];
    currentTl?.progress(1);
    activeIndex = null;
    busy = true;

    window.dispatchEvent(new CustomEvent('track:fade-active'));
    resumeFloats();

    const vp = viewport();
    const tl = gsap.timeline({
      defaults: { duration: 0.6, ease: "power3.out" },
      onComplete: () => {
        busy = false;
        currentTl = null;
        document.body.classList.remove('is-expanded');
        // Fokus zurück auf das Panel, falls er auf dem Back-Button lag oder verloren ging
        const focused = document.activeElement;
        if (focused === resetBtn || focused === document.body || previous.panel.contains(focused)) {
          previous.openBtn?.focus({ preventScroll: true });
        }
      },
    });
    currentTl = tl;

    parts.forEach((p, i) => {
      if (p.player) {
        p.player.style.pointerEvents = "none";
        tl.to(p.player, { autoAlpha: 0, y: 24, duration: 0.25 }, 0);
      }
      if (p.header) tl.to(p.header, { y: 0, opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" }, 0);
      if (p.artwork) tl.to(p.artwork, { scale: 1, opacity: 1, y: 0 }, 0);
      if (p.bgImage) tl.to(p.bgImage, { scale: 1 }, 0);
      tl.to(p.panel, collapsedBox(i, vp), 0);
    });
    tl.to(resetBtn, { bottom: -100, autoAlpha: 0, duration: 0.3, ease: "power2.in" }, 0);

    if (prefersReducedMotion()) tl.timeScale(6);
  }

  resetBtn.addEventListener('click', collapse);

  window.addEventListener('keydown', (e) => {
    // Ist das Info-Overlay offen, schließt Escape zuerst nur das Overlay
    if (e.key !== 'Escape' || e.defaultPrevented || document.body.classList.contains('info-open')) return;
    collapse();
  });
</script>
