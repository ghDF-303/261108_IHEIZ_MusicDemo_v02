---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Track Selection - Sliding Doors Symmetrical</title>
    <style>
      /* DESKTOP-SCHIENEN-SYSTEM */
      @media (min-width: 768px) {
        .sliding-panel {
          clip-path: polygon(15vw 0%, 100% 0%, calc(100% - 15vw) 100%, 0% 100%);
          width: 55vw;
          height: 100%;
        }
        #panel-1 { left: 0; transform-origin: left center; }
        #panel-2 { left: 50%; transform: translateX(-50%); }
        #panel-3 { right: 0; transform-origin: right center; }
      }

      /* MOBILE-SCHIENEN-SYSTEM */
      @media (max-width: 767px) {
        .sliding-panel {
          width: 100%;
          height: 33.34vh;
          left: 0;
        }
      }

      /* Dynamischer Cursor: Pointer nur im Auswahl-Zustand */
      .sliding-panel {
        cursor: pointer;
      }
      body.is-expanded .sliding-panel {
        cursor: default;
      }

      /* Parallelogramm-Button (Gleicher Winkel wie Panels) */
      #reset-btn {
        clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
      }
    </style>
  </head>
  <body class="bg-black text-white h-screen overflow-hidden select-none">

    <!-- Hauptbühne -->
    <main class="relative w-full h-full overflow-hidden flex flex-col md:flex-row items-center">
      
      <!-- PANEL 1 (Links) -->
      <section id="panel-1" data-index="1" class="sliding-panel absolute bg-gradient-to-br from-red-900 to-red-600 flex flex-col items-center justify-center z-10">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 01</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-red-200 mt-2">Industrial Beats</p>
        </div>
      </section>

      <!-- PANEL 2 (Mitte) -->
      <section id="panel-2" data-index="2" class="sliding-panel absolute bg-gradient-to-br from-amber-800 to-amber-500 flex flex-col items-center justify-center z-20">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 02</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-amber-200 mt-2">Cyberpunk Synth</p>
        </div>
      </section>

      <!-- PANEL 3 (Rechts) -->
      <section id="panel-3" data-index="3" class="sliding-panel absolute bg-gradient-to-br from-slate-800 to-slate-600 flex flex-col items-center justify-center z-10">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 03</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-slate-200 mt-2">Heavy Bass</p>
        </div>
      </section>

      <!-- ZURÜCK BUTTON -->
      <button id="reset-btn" class="absolute bottom-[-100px] left-1/2 transform -translate-x-1/2 z-50 bg-white text-black font-black uppercase tracking-widest px-10 py-4 shadow-2xl flex items-center gap-2 cursor-pointer hover:scale-105 active:scale-95 transition-transform opacity-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Zurück
      </button>

    </main>

    <script>
      import { gsap } from "gsap";

      const resetBtn = document.getElementById('reset-btn');
      const contents = document.querySelectorAll('.panel-content');
      let isExpanded = false;

      function initLayout() {
        const isDesktop = window.innerWidth >= 768;
        gsap.killTweensOf(["#panel-1", "#panel-2", "#panel-3"]);
        
        if (isDesktop) {
          gsap.set("#panel-1", { x: "-10vw", width: "55vw", height: "100%" });
          gsap.set("#panel-2", { x: "0vw", width: "55vw", height: "100%", left: "50%", xPercent: -50 });
          gsap.set("#panel-3", { x: "10vw", width: "55vw", height: "100%" });
        } else {
          gsap.set("#panel-1", { x: 0, y: "0vh", width: "100%", height: "33.34vh" });
          gsap.set("#panel-2", { x: 0, y: "33.34vh", width: "100%", height: "33.34vh", left: 0, xPercent: 0 });
          gsap.set("#panel-3", { x: 0, y: "66.68vh", width: "100%", height: "33.34vh" });
        }
      }

      initLayout();
      window.addEventListener('resize', () => { if (!isExpanded) initLayout(); });

      document.querySelectorAll('.sliding-panel').forEach(panel => {
        panel.addEventListener('click', () => {
          if (isExpanded) return;
          isExpanded = true;
          document.body.classList.add('is-expanded');
          
          const index = panel.getAttribute('data-index');
          const isDesktop = window.innerWidth >= 768;
          const tl = gsap.timeline();

          contents.forEach(c => {
            if (!panel.contains(c)) gsap.to(c, { opacity: 0, scale: 0.9, duration: 0.3 });
          });

          if (isDesktop) {
            if (index === "1") {
              tl.to("#panel-1", { x: "0vw", width: "140vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { x: "100vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { x: "132.5vw", duration: 0.7, ease: "power2.inOut" }, 0);
            } 
            else if (index === "2") {
              tl.to("#panel-1", { x: "-100vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { width: "100vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { x: "100vw", duration: 0.7, ease: "power2.inOut" }, 0);
            } 
            else if (index === "3") {
              tl.to("#panel-3", { x: "0vw", width: "140vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { x: "-100vw", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-1", { x: "-132.5vw", duration: 0.7, ease: "power2.inOut" }, 0);
            }
          } else {
            if (index === "1") {
              tl.to("#panel-1", { y: "0vh", height: "100vh", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to(["#panel-2", "#panel-3"], { y: "100vh", duration: 0.7, ease: "power2.inOut" }, 0);
            }
            else if (index === "2") {
              tl.to("#panel-1", { y: "-100vh", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { y: "0vh", height: "100vh", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { y: "100vh", duration: 0.7, ease: "power2.inOut" }, 0);
            }
            else if (index === "3") {
              tl.to(["#panel-1", "#panel-2"], { y: "-100vh", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { y: "0vh", height: "100vh", duration: 0.7, ease: "power2.inOut" }, 0);
            }
          }

          tl.to(resetBtn, { bottom: "40px", opacity: 1, duration: 0.5, ease: "back.out(1.4)" }, "-=0.1");
        });
      });

      // Reset-Button
      resetBtn.addEventListener('click', () => {
        const tl = gsap.timeline({ 
          onComplete: () => { 
            isExpanded = false; 
            document.body.classList.remove('is-expanded');
          } 
        });
        
        tl.to(resetBtn, { bottom: "-100px", opacity: 0, duration: 0.3, ease: "power2.in" });
        contents.forEach(c => gsap.to(c, { opacity: 1, scale: 1, duration: 0.4 }));

        const isDesktop = window.innerWidth >= 768;

        if (isDesktop) {
          tl.to("#panel-1", { x: "-10vw", width: "55vw", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-2", { x: "0vw", width: "55vw", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-3", { x: "10vw", width: "55vw", duration: 0.6, ease: "power3.out" }, 0);
        } else {
          tl.to("#panel-1", { y: "0vh", height: "33.34vh", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-2", { y: "33.34vh", height: "33.34vh", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-3", { y: "66.68vh", height: "33.34vh", duration: 0.6, ease: "power3.out" }, 0);
        }
      });
    </script>
  </body>
</html>