---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Track Selection - Demo</title>
    <style>
      /* Desktop-Schräge für die Spalten mittels clip-path */
      @media (min-width: 768px) {
        .panel-clip-1 { clip-path: polygon(0 0, 105% 0, 85% 100%, 0 100%); }
        .panel-clip-2 { clip-path: polygon(20% 0, 105% 0, 85% 100%, 0 100%); }
        .panel-clip-3 { clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%); }
      }
      /* Optional: Sanfter Übergang für den Clip-Path beim Expandieren (wird von GSAP unterstützt) */
      .panel {
        transition: clip-path 0.5s cubic-bezier(0.25, 1, 0.5, 1);
      }
    </style>
  </head>
  <body class="bg-black text-white h-screen overflow-hidden select-none">

    <!-- Container für den gesamten Viewport -->
    <main id="main-container" class="relative w-full h-full flex flex-col md:flex-row overflow-hidden">
      
      <!-- SPALTE 1 (Track 1 / Oben bei Mobile) -->
      <section data-index="1" class="panel panel-clip-1 w-full h-[33.33vh] md:h-full md:w-[38%] bg-gradient-to-br from-red-900 to-red-600 flex flex-col items-center justify-center cursor-pointer absolute md:static top-0 left-0 z-10 origin-left">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 01</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-red-200 mt-2">Industrial Beats</p>
        </div>
      </section>

      <!-- SPALTE 2 (Track 2 / Mitte bei Mobile) -->
      <!-- Die Spalten überlappen sich im Desktop durch negative Margins leicht, damit die Schrägen passen -->
      <section data-index="2" class="panel panel-clip-2 w-full h-[33.33vh] md:h-full md:w-[38%] md:-ml-[8%] bg-gradient-to-br from-amber-800 to-amber-500 flex flex-col items-center justify-center cursor-pointer absolute md:static top-[33.33vh] left-0 z-20">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 02</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-amber-200 mt-2">Cyberpunk Synth</p>
        </div>
      </section>

      <!-- SPALTE 3 (Track 3 / Unten bei Mobile) -->
      <section data-index="3" class="panel panel-clip-3 w-full h-[33.34vh] md:h-full md:w-[38%] md:-ml-[8%] bg-gradient-to-br from-slate-800 to-slate-600 flex flex-col items-center justify-center cursor-pointer absolute md:static bottom-0 left-0 z-10 origin-right">
        <div class="panel-content text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 03</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-slate-200 mt-2">Heavy Bass</p>
        </div>
      </section>

      <!-- ZURÜCK BUTTON (Initial versteckt im Off unterhalb des Screens) -->
      <button id="reset-btn" class="absolute bottom-[-100px] left-1/2 transform -translate-x-1/2 z-50 bg-white text-black font-black uppercase tracking-widest px-8 py-4 rounded-full shadow-2xl flex items-center gap-2 hover:scale-105 active:scale-95 transition-transform">
        <!-- Temporäre Dummy SVG -->
        <svg xmlns="http://w3.org" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Zurück
      </button>

    </main>

    <!-- GSAP ARCHITEKTUR -->
    <script>
      import { gsap } from "gsap";

      const panels = document.querySelectorAll('.panel');
      const resetBtn = document.getElementById('reset-btn');
      let isExpanded = false;

      // Event Listener für alle Spalten registrieren
      panels.forEach(panel => {
        panel.addEventListener('click', () => {
          if (isExpanded) return; // Klicks ignorieren, wenn schon eine Spalte offen ist
          isExpanded = true;
          
          const index = panel.getAttribute('data-index');
          const isDesktop = window.innerWidth >= 768;

          // Wir erstellen eine Master-Timeline für exakt getaktete Abläufe
          const tl = gsap.timeline();

          if (isDesktop) {
            // --- DESKTOP ANIMATION (Horizontal) ---
            
            // Bevor wir schieben, entfernen wir die Schrägen (clip-path), 
            // damit die aktive Spalte nahtlos den ganzen Bildschirm füllt.
            tl.to(panel, { clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)', duration: 0.4, ease: "power2.inOut" });

            if (index === "1") {
              // Spalte 1 dehnt sich aus, Spalte 2 & 3 fliegen nach rechts raus
              tl.to(panels[0], { width: "100%", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to([panels[1], panels[2]], { x: "150vw", duration: 0.8, ease: "power4.inIn" }, 0);
            } 
            else if (index === "2") {
              // Spalte 2 zentriert sich und füllt alles, Spalte 1 nach links, Spalte 3 nach rechts raus
              // Wir müssen das negative Margin ausgleichen
              tl.to(panels[1], { width: "100%", marginLeft: "0%", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to(panels[0], { x: "-150vw", duration: 0.8, ease: "power4.inIn" }, 0);
              tl.to(panels[2], { x: "150vw", duration: 0.8, ease: "power4.inIn" }, 0);
            } 
            else if (index === "3") {
              // Spalte 3 dehnt sich aus, Spalte 1 & 2 fliegen nach links raus
              tl.to(panels[2], { width: "100%", marginLeft: "0%", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to([panels[0], panels[1]], { x: "-150vw", duration: 0.8, ease: "power4.inIn" }, 0);
            }
          } else {
            // --- MOBILE ANIMATION (Vertikal) ---
            if (index === "1") {
              // Spalte 1 füllt den Screen, 2 & 3 nach unten weg
              tl.to(panels[0], { height: "100vh", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to([panels[1], panels[2]], { y: "150vh", duration: 0.8, ease: "power4.inIn" }, 0);
            }
            else if (index === "2") {
              // Spalte 2 füllt den Screen, 1 nach oben weg, 3 nach unten weg
              tl.to(panels[1], { top: "0vh", height: "100vh", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to(panels[0], { y: "-150vh", duration: 0.8, ease: "power4.inIn" }, 0);
              tl.to(panels[2], { y: "150vh", duration: 0.8, ease: "power4.inIn" }, 0);
            }
            else if (index === "3") {
              // Spalte 3 füllt den Screen, 1 & 2 nach oben weg
              tl.to(panels[2], { height: "100vh", duration: 0.8, ease: "power4.inOut" }, 0);
              tl.to([panels[0], panels[1]], { y: "-150vh", duration: 0.8, ease: "power4.inIn" }, 0);
            }
          }

          // Wenn die Spalten-Animation fertig ist, kommt der Button von unten reingeslided
          tl.to(resetBtn, {
            bottom: "40px",
            duration: 0.6,
            ease: "back.out(1.7)"
          });
        });
      });

      // Reset-Button Funktionalität (Zurück zum Ursprung)
      resetBtn.addEventListener('click', () => {
        const tl = gsap.timeline({
          onComplete: () => { isExpanded = false; }
        });

        // 1. Button verschwindet zuerst wieder nach unten
        tl.to(resetBtn, { bottom: "-100px", duration: 0.4, ease: "power2.in" });

        // 2. Alle Spalten-Werte (Breiten, Höhen, Positionen, Margins) zurücksetzen
        tl.to(panels, {
          width: "",
          height: "",
          x: 0,
          y: 0,
          marginLeft: "",
          top: "",
          duration: 0.8,
          ease: "power4.out"
        }, "-=0.2");

        // 3. Schrägen auf Desktop wiederherstellen
        if (window.innerWidth >= 768) {
          tl.to(panels[0], { clipPath: 'polygon(0 0, 105% 0, 85% 100%, 0 100%)', duration: 0.3 }, "-=0.5");
          tl.to(panels[1], { clipPath: 'polygon(20% 0, 105% 0, 85% 100%, 0 100%)', duration: 0.3 }, "-=0.5");
          tl.to(panels[2], { clipPath: 'polygon(20% 0, 100% 0, 100% 100%, 0 100%)', duration: 0.3 }, "-=0.5");
        }
      });
    </script>
  </body>
</html>
