---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Track Selection - Seamless Demo</title>
    <style>
      /* Desktop-Ausgangszustand (Lückenlos berechnet auf 100% Gesamtbreite) */
      @media (min-width: 768px) {
        #panel-1 { clip-path: polygon(0% 0%, 38% 0%, 28% 100%, 0% 100%); }
        #panel-2 { clip-path: polygon(38% 0%, 71% 0%, 61% 100%, 28% 100%); }
        #panel-3 { clip-path: polygon(71% 0%, 100% 0%, 100% 100%, 61% 100%); }
      }

      /* Mobile-Ausgangszustand (Lückenlos berechnet auf 100% Gesamthöhe) */
      @media (max-width: 767px) {
        #panel-1 { clip-path: polygon(0% 0%, 100% 0%, 100% 33.33%, 0% 33.33%); }
        #panel-2 { clip-path: polygon(0% 33.33%, 100% 33.33%, 100% 66.66%, 0% 66.66%); }
        #panel-3 { clip-path: polygon(0% 66.66%, 100% 66.66%, 100% 100%, 0% 100%); }
      }
    </style>
  </head>
  <body class="bg-black text-white h-screen overflow-hidden select-none">

    <!-- Hauptcontainer: Alle Spalten liegen absolut übereinander, um Blitzer zu vermeiden -->
    <main class="relative w-full h-full overflow-hidden">
      
      <!-- TRACK 1 -->
      <section id="panel-1" data-index="1" class="panel absolute inset-0 bg-gradient-to-br from-red-900 to-red-600 flex flex-col items-center justify-center cursor-pointer z-10">
        <div class="text-center md:absolute md:left-[15%]">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 01</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-red-200 mt-2">Industrial Beats</p>
        </div>
      </section>

      <!-- TRACK 2 -->
      <section id="panel-2" data-index="2" class="panel absolute inset-0 bg-gradient-to-br from-amber-800 to-amber-500 flex flex-col items-center justify-center cursor-pointer z-10">
        <div class="text-center">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 02</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-amber-200 mt-2">Cyberpunk Synth</p>
        </div>
      </section>

      <!-- TRACK 3 -->
      <section id="panel-3" data-index="3" class="panel absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-600 flex flex-col items-center justify-center cursor-pointer z-10">
        <div class="text-center md:absolute md:right-[15%]">
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">Track 03</h2>
          <p class="text-sm font-bold uppercase tracking-widest text-slate-200 mt-2">Heavy Bass</p>
        </div>
      </section>

      <!-- ZURÜCK BUTTON -->
      <button id="reset-btn" class="absolute bottom-[-100px] left-1/2 transform -translate-x-1/2 z-50 bg-white text-black font-black uppercase tracking-widest px-8 py-4 rounded-full shadow-2xl flex items-center gap-2 hover:scale-105 active:scale-95 transition-transform opacity-0">
        <svg xmlns="http://w3.org" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Zurück
      </button>

    </main>

    <script>
      import { gsap } from "gsap";

      const panels = document.querySelectorAll('.panel');
      const resetBtn = document.getElementById('reset-btn');
      let isExpanded = false;

      panels.forEach(panel => {
        panel.addEventListener('click', () => {
          if (isExpanded) return;
          isExpanded = true;
          
          const index = panel.getAttribute('data-index');
          const isDesktop = window.innerWidth >= 768;
          const tl = gsap.timeline();

          if (isDesktop) {
            // --- DESKTOP SEAMLESS FAN ANIMATION ---
            // Wir animieren die Masken-Eckpunkte synchron.
            // Die geklickte Spalte drückt mit hoher Beschleunigung (power4.out) nach außen.
            if (index === "1") {
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, 110% 0%, 100% 100%, 0% 100%)", duration: 0.5, ease: "power4.out" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(110% 0%, 110% 0%, 100% 100%, 100% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(110% 0%, 110% 0%, 100% 100%, 100% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
            } 
            else if (index === "2") {
              // Mitte dehnt sich nach links und rechts aus und behält dabei die Schrägen konstant beim Schieben bei
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, -10% 0%, -10% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(-10% 0%, 110% 0%, 110% 100%, -10% 100%)", duration: 0.5, ease: "power4.out" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(110% 0%, 110% 0%, 110% 100%, 110% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
            } 
            else if (index === "3") {
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, -10% 0%, 0% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(-10% 0%, -10% 0%, 0% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(-10% 0%, 100% 0%, 100% 100%, 0% 100%)", duration: 0.5, ease: "power4.out" }, 0);
            }
          } else {
            // --- MOBILE SEAMLESS VERTICAL ANIMATION ---
            if (index === "1") {
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)", duration: 0.5, ease: "power4.out" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
            }
            else if (index === "2") {
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)", duration: 0.5, ease: "power4.out" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)", duration: 0.7, ease: "power2.inOut" }, 0);
            }
            else if (index === "3") {
              tl.to("#panel-1", { clipPath: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-2", { clipPath: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)", duration: 0.7, ease: "power2.inOut" }, 0);
              tl.to("#panel-3", { clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)", duration: 0.5, ease: "power4.out" }, 0);
            }
          }

          // Button wird eingeblendet und fährt hoch
          tl.to(resetBtn, {
            bottom: "40px",
            opacity: 1,
            duration: 0.6,
            ease: "back.out(1.5)"
          }, "-=0.1");
        });
      });

      // Reset-Button (Zurück in die Ausgangs-Verschachtelung)
      resetBtn.addEventListener('click', () => {
        const tl = gsap.timeline({
          onComplete: () => { isExpanded = false; }
        });

        tl.to(resetBtn, { bottom: "-100px", opacity: 0, duration: 0.4, ease: "power2.in" });

        const isDesktop = window.innerWidth >= 768;

        if (isDesktop) {
          tl.to("#panel-1", { clipPath: "polygon(0% 0%, 38% 0%, 28% 100%, 0% 100%)", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-2", { clipPath: "polygon(38% 0%, 71% 0%, 61% 100%, 28% 100%)", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-3", { clipPath: "polygon(71% 0%, 100% 0%, 100% 100%, 61% 100%)", duration: 0.6, ease: "power3.out" }, 0);
        } else {
          tl.to("#panel-1", { clipPath: "polygon(0% 0%, 100% 0%, 100% 33.33%, 0% 33.33%)", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-2", { clipPath: "polygon(0% 33.33%, 100% 33.33%, 100% 66.66%, 0% 66.66%)", duration: 0.6, ease: "power3.out" }, 0);
          tl.to("#panel-3", { clipPath: "polygon(0% 66.66%, 100% 66.66%, 100% 100%, 0% 100%)", duration: 0.6, ease: "power3.out" }, 0);
        }
      });
    </script>
  </body>
</html>
