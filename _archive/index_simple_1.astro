---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>

  <body class="bg-slate-950 text-white overflow-x-hidden">
    
    <!-- Hero Sektion -->
    <main class="flex min-h-screen flex-col items-center justify-center p-8 relative">
      
      <!-- Hintergrund-Deko (Schräger Gaming-Slice) -->
      <div id="bg-slice" class="absolute inset-0 bg-red-600 opacity-20 -skew-y-12 scale-110 origin-top-left -z-10"></div>

      <!-- Hauptinhalt -->
      <div class="text-center z-10">
        <h1 id="hero-title" class="text-6xl md:text-8xl font-black tracking-tighter uppercase mb-4">
          Sound <span class="text-red-500">Project</span>
        </h1>
        <p id="hero-sub" class="text-xl md:text-2xl text-slate-400 font-medium max-w-xl mx-auto mb-8">
          Erlebe den neuen Crossover-Sound. Dynamisch, laut und kompromisslos.
        </p>
      </div>

      <!-- Demo Box für das zukünftige Artwork -->
      <div id="hero-artwork" class="w-64 h-64 md:w-96 md:h-96 bg-gradient-to-tr from-red-500 to-amber-500 rounded-2xl shadow-2xl flex items-center justify-center border-4 border-white mt-4">
        <span class="font-bold uppercase tracking-widest text-sm text-white">Hier steht dein Artwork</span>
      </div>

    </main>

    <!-- HIER KOMMT DAS GSAP-SKRIPT -->
    <script>
      // Wir importieren den GSAP-Core
      import { gsap } from "gsap";

      // Sobald das Skript im Browser geladen wird, feuern wir die Animation ab
      // .from() animiert VON den angegebenen Werten HIN zum CSS-Zustand
      
      // 1. Der Titel poppt auf
      gsap.from("#hero-title", {
        duration: 1,
        y: 50,
        opacity: 0,
        ease: "power4.out",
        delay: 0.2
      });

      // 2. Der Untertext folgt kurz danach
      gsap.from("#hero-sub", {
        duration: 1,
        y: 30,
        opacity: 0,
        ease: "power3.out",
        delay: 0.4
      });

      // 3. Das Artwork fliegt mit einem elastischen "Zenless Zone Zero"-Effekt von rechts ein
      gsap.from("#hero-artwork", {
        duration: 1.2,
        x: 200,
        rotation: 15,
        opacity: 0,
        ease: "back.out(1.5)", // Sorgt für das leichte Übersteuern/Federn am Ende
        delay: 0.6
      });

      // 4. Der Hintergrund-Balken slidet von links rein
      gsap.from("#bg-slice", {
        duration: 1.5,
        x: -500,
        opacity: 0,
        ease: "power2.out"
      });
    </script>

  </body>
</html>
